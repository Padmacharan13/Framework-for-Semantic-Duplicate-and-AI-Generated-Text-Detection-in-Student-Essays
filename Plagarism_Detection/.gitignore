.env
.env.local
.env.*.local
*.env
*.pem
*.key
secrets.json
config.secret.py
sensitive/
*sensitive*

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

